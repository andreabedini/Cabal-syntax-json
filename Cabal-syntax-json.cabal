cabal-version:   3.8
name:            Cabal-syntax-json
version:         0.1.0.0
synopsis:        Turn a .cabal file into a robust JSON representation
description:
  Render a @.cabal@ file as JSON, using @Cabal-syntax@'s own parser and field
  grammars. Conditionals are pushed down into each field, so every value
  carries the condition under which it applies, and can be partially
  evaluated against flags, operating system, architecture and compiler.
  The package ships a library and the @cabal2json@ executable.
category:        Distribution
homepage:        https://github.com/andreabedini/Cabal-syntax-json
bug-reports:     https://github.com/andreabedini/Cabal-syntax-json/issues
license:         MIT
license-file:    LICENSE
author:          Andrea Bedini
maintainer:      andrea@andreabedini.com
build-type:      Simple
extra-doc-files: CHANGELOG.md
                 README.md

source-repository head
  type:     git
  location: https://github.com/andreabedini/Cabal-syntax-json

library
  build-depends:      base         ^>=4.20 || ^>=4.21
                    , bytestring   ^>=0.12
                    , containers   ^>=0.7
                    , Cabal        ^>=3.12 || ^>=3.14
                    , Cabal-syntax ^>=3.12 || ^>=3.14
                    , pretty       ^>=1.1
  exposed-modules:    Cabal.Syntax.Compat
                      Cabal.Syntax.CondTree
                      Cabal.Syntax.GenericPackageDescription
                      Cabal.Syntax.Json
                      Cabal.Syntax.JsonFieldGrammar
                      Cabal.Syntax.Pipeline
                      Cabal.Syntax.ListMap
                      Cabal.Syntax.Pretty
                      Cabal.Syntax.Simplify
                      Cabal.Syntax.Utils
  hs-source-dirs:     src
  default-language:   GHC2021

executable cabal2json
  main-is:            Main.hs
  build-depends:      base
                    , bytestring
                    , containers
                    , Cabal
                    , Cabal-syntax
                    , Cabal-syntax-json
                    , pretty
  hs-source-dirs:     app
  default-language:   GHC2021

test-suite golden-tests
  main-is:            Tests.hs
  build-depends:    , base
                    , Cabal-syntax-json
                    , Cabal
                    , Cabal-syntax
                    , filepath
                    , process
                    , tasty
                    , tasty-hunit
                    , tasty-golden
  build-tool-depends: Cabal-syntax-json:cabal2json
  hs-source-dirs:     tests
  default-language:   GHC2021
